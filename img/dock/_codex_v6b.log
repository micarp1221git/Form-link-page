+<!doctype html>
+<html lang="ja">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>声の人間ドック | ボイストレーナーみか</title>
+<meta name="description" content="年に1回、声を録って送るだけで、検査数値とボイストレーナーの所見が1枚のレポートで届く総合健診。">
+<meta name="robots" content="noindex">
+<link rel="preconnect" href="https://fonts.googleapis.com">
+<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
+<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;800;900&display=swap" rel="stylesheet">
+<style>
+  :root {
+    --coral: #E8815B;
+    --coral-dark: #B95736;
+    --peach: #FFF8F5;
+    --peach-2: #FDECE3;
+    --ink: #3D3535;
+    --muted: #756765;
+    --line: #EEDFD8;
+    --sage: #809C8A;
+    --cream: #FFFDFB;
+    --white: #fff;
+    --shadow: 0 18px 44px rgba(61, 53, 53, .09);
+  }
+
+  * {
+    box-sizing: border-box;
+  }
+
+  html {
+    scroll-behavior: smooth;
+  }
+
+  body {
+    margin: 0;
+    color: var(--ink);
+    background: var(--cream);
+    font-family: "Noto Sans JP", sans-serif;
+    font-size: 16px;
+    line-height: 1.9;
+    letter-spacing: 0;
+    -webkit-font-smoothing: antialiased;
+  }
+
+  img {
+    display: block;
+    max-width: 100%;
+    height: auto;
+  }
+
+  a {
+    color: inherit;
+  }
+
+  .wrap {
+    width: min(1120px, calc(100% - 40px));
+    margin: 0 auto;
+  }
+
+  .section {
+    padding: 84px 0;
+    position: relative;
+  }
+
+  .band {
+    background: var(--peach);
+  }
+
+  .band-strong {
+    background: linear-gradient(180deg, #FDECE3 0%, #FFF8F5 100%);
+  }
+
+  .label {
+    display: inline-flex;
+    align-items: center;
+    min-height: 28px;
+    padding: 4px 12px;
+    border-radius: 999px;
+    color: var(--coral-dark);
+    background: var(--peach-2);
+    font-size: 13px;
+    font-weight: 800;
+  }
+
+  .center {
+    text-align: center;
+  }
+
+  .hero {
+    padding: 28px 0 72px;
+    background:
+      radial-gradient(circle at 8% 18%, rgba(232, 129, 91, .12), transparent 32%),
+      linear-gradient(180deg, var(--peach) 0%, #fff 100%);
+    overflow: hidden;
+  }
+
+  .person {
+    display: flex;
+    align-items: center;
+    gap: 12px;
+    width: fit-content;
+    max-width: 100%;
+    margin-top: 18px;
+    padding: 8px 14px 8px 8px;
+    border: 1px solid rgba(232, 129, 91, .25);
+    border-radius: 999px;
+    background: rgba(255, 255, 255, .82);
+    box-shadow: 0 10px 28px rgba(61, 53, 53, .08);
+    backdrop-filter: blur(10px);
+  }
+
+  .person img {
+    width: 54px;
+    height: 54px;
+    border-radius: 50%;
+    object-fit: cover;
+  }
+
+  .person span {
+    font-size: 13px;
+    font-weight: 800;
+    line-height: 1.5;
+  }
+
+  .hero-copy {
+    padding: 48px 0 0;
+  }
+
+  .hero-grid {
+    display: grid;
+    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
+    gap: 40px;
+    align-items: center;
+  }
+
+  .hero-media {
+    align-self: end;
+    overflow: hidden;
+    border: 1px solid rgba(232, 129, 91, .24);
+    border-radius: 8px;
+    background: #fff;
+    box-shadow: var(--shadow);
+  }
+
+  .hero-media img {
+    width: 100%;
+    height: 100%;
+    min-height: 420px;
+    object-fit: cover;
+    object-position: center;
+  }
+
+  .mutter {
+    margin: 0 0 28px;
+    padding-left: 18px;
+    border-left: 4px solid var(--coral);
+    color: var(--muted);
+    font-size: clamp(18px, 2vw, 23px);
+    font-weight: 700;
+    line-height: 1.9;
+  }
+
+  h1,
+  h2,
+  h3 {
+    margin: 0;
+    font-weight: 900;
+    letter-spacing: 0;
+    line-height: 1.45;
+  }
+
+  h1 {
+    font-size: clamp(42px, 6vw, 76px);
+    line-height: 1.16;
+  }
+
+  h2 {
+    font-size: clamp(29px, 4vw, 48px);
+  }
+
+  h3 {
+    font-size: clamp(21px, 2.6vw, 30px);
+  }
+
+  .promise {
+    margin: 24px 0 26px;
+    font-size: clamp(19px, 2.3vw, 25px);
+    font-weight: 800;
+    line-height: 1.8;
+  }
+
+  .period {
+    display: inline-flex;
+    max-width: 100%;
+    padding: 16px 20px;
+    border: 1px solid rgba(61, 53, 53, .18);
+    border-left: 6px solid var(--coral);
+    border-radius: 8px;
+    background: rgba(255, 255, 255, .78);
+    color: var(--ink);
+    font-weight: 800;
+    box-shadow: 0 8px 26px rgba(61, 53, 53, .06);
+  }
+
+  .cards {
+    display: grid;
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    gap: 22px;
+    margin-top: 38px;
+  }
+
+  .card {
+    min-width: 0;
+    border: 1px solid var(--line);
+    border-radius: 8px;
+    background: var(--white);
+    box-shadow: 0 10px 32px rgba(61, 53, 53, .055);
+    overflow: hidden;
+  }
+
+  .concern-card {
+    display: flex;
+    flex-direction: column;
+  }
+
+  .concern-card img {
+    width: 100%;
+    aspect-ratio: 1 / 1;
+    object-fit: cover;
+    background: var(--peach);
+  }
+
+  .concern-card p {
+    margin: 0;
+    padding: 20px;
+    font-weight: 800;
+    line-height: 1.8;
+  }
+
+  .lead-block {
+    width: min(820px, 100%);
+    margin: 0 auto;
+  }
+
+  .lead-block p {
+    margin: 22px 0 0;
+    font-size: clamp(17px, 2vw, 20px);
+    font-weight: 700;
+  }
+
+  .plain p {
+    margin: 20px 0 0;
+  }
+
+  .two-col {
+    display: grid;
+    grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
+    gap: 54px;
+    align-items: center;
+    margin-top: 38px;
+  }
+
+  .pillars {
+    display: grid;
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    gap: 16px;
+    margin-top: 28px;
+  }
+
+  .pillar {
+    padding: 18px 16px;
+    border-top: 4px solid var(--coral);
+    border-radius: 0 0 8px 8px;
+    background: rgba(255, 255, 255, .78);
+  }
+
+  .pillar b {
+    display: block;
+    margin-bottom: 8px;
+    color: var(--coral-dark);
+    font-size: 20px;
+    font-weight: 900;
+  }
+
+  .pillar span {
+    color: var(--muted);
+    font-size: 14px;
+    font-weight: 700;
+    line-height: 1.7;
+  }
+
+  .solution-art {
+    border-radius: 8px;
+    overflow: hidden;
+    background: #fff;
+    box-shadow: var(--shadow);
+  }
+
+  .solution-art img {
+    width: 100%;
+    aspect-ratio: 16 / 9;
+    object-fit: cover;
+    object-position: center;
+  }
+
+  .bullets {
+    margin: 22px 0 0;
+    padding: 0;
+    list-style: none;
+    display: grid;
+    gap: 12px;
+  }
+
+  .bullets li {
+    position: relative;
+    padding: 14px 16px 14px 44px;
+    border: 1px solid var(--line);
+    border-radius: 8px;
+    background: var(--white);
+    font-weight: 800;
+  }
+
+  .bullets li::before {
+    content: "";
+    position: absolute;
+    top: 22px;
+    left: 18px;
+    width: 10px;
+    height: 10px;
+    border-radius: 50%;
+    background: var(--coral);
+  }
+
+  .report-grid {
+    display: grid;
+    grid-template-columns: minmax(0, .88fr) minmax(0, 1.12fr);
+    gap: 54px;
+    align-items: center;
+    margin-top: 38px;
+  }
+
+  .report-frame {
+    padding: 14px;
+    border: 1px solid var(--line);
+    border-radius: 8px;
+    background: var(--white);
+    box-shadow: var(--shadow);
+  }
+
+  .report-frame img {
+    width: 100%;
+    border-radius: 4px;
+  }
+
+  .report-list {
+    margin: 26px 0 0;
+    padding: 0;
+    list-style: none;
+    display: grid;
+    gap: 14px;
+  }
+
+  .report-list li {
+    padding: 18px 18px 18px 20px;
+    border-left: 5px solid var(--coral);
+    border-radius: 0 8px 8px 0;
+    background: var(--white);
+    box-shadow: 0 8px 24px rgba(61, 53, 53, .045);
+  }
+
+  .notice {
+    margin: 18px 0 0;
+    color: var(--muted);
+    font-size: 13px;
+    line-height: 1.8;
+  }
+
+  .steps {
+    display: grid;
+    grid-template-columns: repeat(4, minmax(0, 1fr));
+    gap: 18px;
+    margin-top: 38px;
+    counter-reset: step;
+  }
+
+  .step {
+    min-height: 190px;
+    padding: 24px 18px;
+    border-radius: 8px;
+    background: var(--white);
+    box-shadow: 0 10px 30px rgba(61, 53, 53, .06);
+  }
+
+  .step::before {
+    counter-increment: step;
+    content: counter(step) ".";
+    display: grid;
+    place-items: center;
+    width: 46px;
+    height: 46px;
+    margin-bottom: 18px;
+    border-radius: 50%;
+    color: #fff;
+    background: var(--coral);
+    font-size: 20px;
+    font-weight: 900;
+  }
+
+  .step p {
+    margin: 0;
+    font-size: 17px;
+    font-weight: 800;
+    line-height: 1.75;
+  }
+
+  .price-box {
+    width: min(760px, 100%);
+    margin: 38px auto 0;
+    padding: 44px;
+    border: 1px solid rgba(232, 129, 91, .42);
+    border-radius: 8px;
+    background: var(--white);
+    text-align: center;
+    box-shadow: var(--shadow);
+  }
+
+  .price-line {
+    margin: 0;
+    font-size: clamp(32px, 5vw, 58px);
+    font-weight: 900;
+    line-height: 1.25;
+  }
+
+  .price-line s {
+    margin-right: 14px;
+    color: var(--muted);
+    font-size: .58em;
+    text-decoration-color: var(--coral-dark);
+    text-decoration-thickness: 3px;
+  }
+
+  .price-box p {
+    margin: 18px 0 0;
+  }
+
+  .cta {
+    display: inline-flex;
+    justify-content: center;
+    align-items: center;
+    width: min(100%, 520px);
+    min-height: 66px;
+    margin-top: 28px;
+    padding: 18px 26px;
+    border-radius: 8px;
+    color: #fff;
+    background: var(--coral);
+    box-shadow: 0 14px 30px rgba(232, 129, 91, .28);
+    font-size: clamp(16px, 3.6vw, 20px);
+    font-weight: 900;
+    line-height: 1.45;
+    text-align: center;
+    text-decoration: none;
+  }
+
+  .cta:hover {
+    background: var(--coral-dark);
+  }
+
+  .bonus {
+    width: min(760px, 100%);
+    margin: 38px auto 0;
+    padding: 32px;
+    border-radius: 8px;
+    background: var(--peach);
+    border: 1px solid var(--line);
+  }
+
+  .bonus p {
+    margin: 18px 0 0;
+  }
+
+  .faq {
+    width: min(860px, 100%);
+    margin: 38px auto 0;
+  }
+
+  .qa {
+    padding: 24px 0;
+    border-bottom: 1px solid var(--line);
+  }
+
+  .qa p {
+    margin: 0;
+  }
+
+  .qa p + p {
+    margin-top: 10px;
+  }
+
+  .closing {
+    padding: 84px 0;
+    color: #fff;
+    background: linear-gradient(135deg, #3D3535 0%, #594945 100%);
+  }
+
+  .closing p {
+    margin: 22px 0 0;
+    font-size: clamp(19px, 2.4vw, 26px);
+    font-weight: 900;
+  }
+
+  .closing .cta {
+    background: #fff;
+    color: var(--coral-dark);
+  }
+
+  footer {
+    padding: 30px 20px 42px;
+    color: var(--muted);
+    background: var(--cream);
+    font-size: 13px;
+    text-align: center;
+  }
+
+  footer a {
+    color: var(--muted);
+  }
+
+  footer span {
+    display: inline-block;
+    margin: 0 10px;
+  }
+
+  @media (max-width: 860px) {
+    .hero {
+      padding-bottom: 46px;
+    }
+
+    .hero-copy {
+      padding-top: 30px;
+    }
+
+    .hero-grid {
+      grid-template-columns: 1fr;
+    }
+
+    .cards,
+    .two-col,
+    .report-grid,
+    .steps {
+      grid-template-columns: 1fr;
+    }
+
+    .pillars {
+      grid-template-columns: 1fr;
+    }
+
+  }
+
+  @media (max-width: 520px) {
+    body {
+      font-size: 15.5px;
+    }
+
+    .wrap {
+      width: min(100% - 28px, 1120px);
