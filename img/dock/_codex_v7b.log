+<!doctype html>
+<html lang="ja">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="description" content="声の人間ドック">
+  <title>声の人間ドック</title>
+  <link rel="preconnect" href="https://fonts.googleapis.com">
+  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
+  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700;800&display=swap" rel="stylesheet">
+  <style>
+    :root { --coral:#e8815b; --ink:#3d3535; --paper:#fff8f5; --mist:#f0eeec; --line:#ded8d5; }
+    * { box-sizing:border-box; }
+    html { scroll-behavior:smooth; }
+    body { margin:0; color:var(--ink); background:#fff; font-family:"Noto Sans JP", sans-serif; font-size:15px; font-weight:500; line-height:1.95; letter-spacing:.035em; overflow-x:hidden; }
+    img { display:block; max-width:100%; }
+    a { color:inherit; }
+    .wrap { width:min(1080px, calc(100% - 48px)); margin-inline:auto; }
+    .eyebrow { display:inline-flex; align-items:center; gap:9px; color:var(--coral); font-size:12px; font-weight:800; letter-spacing:.15em; }
+    .eyebrow::before { content:""; width:24px; height:2px; background:var(--coral); }
+    h1,h2,h3,p { margin-top:0; }
+    h2 { font-size:clamp(28px, 4.3vw, 48px); line-height:1.45; letter-spacing:.06em; font-weight:800; }
+    .hero { position:relative; isolation:isolate; overflow:hidden; min-height:690px; background:var(--paper); }
+    .hero::before { content:""; position:absolute; z-index:-1; width:460px; height:460px; border-radius:50%; top:-260px; right:-105px; background:#f7d6c8; }
+    .hero::after { content:""; position:absolute; z-index:-1; width:180px; height:180px; border-radius:50%; bottom:-90px; left:6%; border:38px solid #f3dfd7; }
+    .nav { height:76px; display:flex; align-items:center; justify-content:space-between; }
+    .brand { font-size:15px; font-weight:800; letter-spacing:.13em; text-decoration:none; }
+    .nav a:last-child { border:1px solid var(--coral); color:var(--coral); border-radius:999px; padding:7px 16px; font-size:11px; font-weight:800; text-decoration:none; }
+    .hero-grid { position:relative; display:grid; grid-template-columns: .94fr 1.06fr; align-items:center; min-height:592px; padding-bottom:38px; }
+    .hero-copy { position:relative; z-index:2; padding:36px 0 68px; }
+    .hero-catch { margin:20px 0 10px; font-size:clamp(25px, 3.7vw, 42px); font-weight:800; line-height:1.62; letter-spacing:.075em; }
+    .hero-catch span { display:block; }
+    h1 { margin:23px 0 10px; font-size:clamp(43px, 6.2vw, 71px); line-height:1.15; letter-spacing:.1em; font-weight:800; }
+    .hero-lead { margin-bottom:24px; font-size:16px; line-height:2.0; font-weight:700; }
+    .period { display:inline-block; margin:0; border-top:1px solid var(--ink); border-bottom:1px solid var(--ink); padding:9px 0; font-size:13px; font-weight:700; line-height:1.6; }
+    .hero-art { position:relative; z-index:1; width:calc(100% + 90px); max-width:none; margin-left:-50px; }
+    .profile { display:flex; align-items:center; gap:10px; margin-top:25px; font-size:12px; font-weight:700; line-height:1.45; }
+    .profile img { width:42px; height:42px; object-fit:cover; border-radius:50%; border:2px solid #fff; }
+    .section { padding:112px 0; }
+    .intro { text-align:center; max-width:760px; }
+    .intro .eyebrow { margin-bottom:15px; }
+    .problem { background:#fff; }
+    .problem-copy { max-width:690px; margin:0 auto 44px; font-size:16px; text-align:center; line-height:2.15; }
+    .worry-grid { display:grid; grid-template-columns:repeat(3, 1fr); gap:20px; }
+    .worry { overflow:hidden; border:1px solid #eee8e5; background:var(--paper); }
+    .worry img { width:100%; height:auto; aspect-ratio:1; object-fit:cover; }
+    .worry p { min-height:84px; margin:0; padding:19px 18px 23px; font-weight:700; line-height:1.75; }
+    .solution { position:relative; overflow:hidden; background:var(--mist); }
+    .solution::after { content:""; position:absolute; right:-60px; bottom:-65px; width:220px; height:220px; border:32px solid #f7ddd2; border-radius:50%; }
+    .solution .intro { position:relative; z-index:1; }
+    .solution-text { max-width:760px; margin:0 auto; font-size:16px; text-align:center; }
+    .checklist { list-style:none; padding:0; margin:28px auto 0; width:min(580px, 100%); }
+    .checklist li { position:relative; border-top:1px solid #d8d2cf; padding:13px 0 13px 35px; font-weight:700; }
+    .checklist li::before { content:""; position:absolute; left:3px; top:24px; width:13px; height:7px; border-left:2px solid var(--coral); border-bottom:2px solid var(--coral); transform:rotate(-45deg); }
+    .pillars { position:relative; z-index:1; display:grid; grid-template-columns:repeat(3,1fr); margin-top:48px; border-top:1px solid #d8d2cf; border-bottom:1px solid #d8d2cf; }
+    .pillar { padding:25px 25px 27px; text-align:center; }
+    .pillar + .pillar { border-left:1px solid #d8d2cf; }
+    .pillar b { display:block; color:var(--coral); font-size:24px; line-height:1.2; letter-spacing:.13em; }
+    .report { background:#fff; }
+    .report-grid { display:grid; grid-template-columns:.9fr 1.1fr; align-items:center; gap:7%; }
+    .report-copy p { font-size:16px; }
+    .report-list { padding-left:1.2em; margin:24px 0; }
+    .report-list li { padding-left:.35em; margin:10px 0; }
+    .note { margin-bottom:0; color:#6d6462; font-size:12px !important; line-height:1.8; }
+    .medical-note { margin:15px 0 0; padding-top:15px; border-top:1px solid var(--line); color:#6d6462; font-size:12px !important; line-height:1.8; }
+    .report-image { position:relative; padding:16px; background:var(--paper); }
+    .report-image::before { content:""; position:absolute; right:-16px; top:-16px; width:88px; height:88px; border-radius:50%; background:#f7d6c8; z-index:0; }
+    .report-image img { position:relative; z-index:1; width:100%; height:auto; box-shadow:0 12px 28px rgba(61,53,53,.12); }
+    .flow { background:var(--paper); }
+    .flow .intro { margin-bottom:42px; }
+    .flow-grid { display:grid; grid-template-columns:repeat(4, 1fr); gap:16px; }
+    .flow-card { position:relative; background:#fff; padding:13px 13px 20px; text-align:center; }
+    .flow-card:not(:last-child)::after { content:""; position:absolute; right:-11px; top:43%; z-index:2; width:20px; height:20px; border-right:1px solid var(--coral); border-top:1px solid var(--coral); transform:rotate(45deg); background:var(--paper); }
+    .flow-number { position:absolute; top:8px; left:8px; display:grid; place-items:center; width:29px; height:29px; border-radius:50%; color:#fff; background:var(--coral); font-size:12px; font-weight:800; line-height:1; }
+    .flow-card img { width:100%; height:auto; aspect-ratio:1; object-fit:cover; }
+    .flow-card p { margin:9px 0 0; min-height:58px; font-size:13px; font-weight:700; line-height:1.65; }
+    .price { background:#fff; }
+    .price-box { max-width:765px; margin:auto; padding:58px clamp(24px,6vw,80px); border:1px solid var(--line); text-align:center; background:var(--paper); }
+    .price-box h2 { margin-bottom:22px; }
+    .price-line { margin:0 0 20px; font-size:clamp(22px,3.3vw,31px); font-weight:800; letter-spacing:.04em; }
+    .price-line s { color:#847b78; font-size:.73em; margin-right:9px; text-decoration-thickness:1px; }
+    .price-copy { text-align:left; margin:0 auto 29px; max-width:530px; font-size:14px; }
+    .cta { display:flex; align-items:center; justify-content:center; min-height:66px; padding:12px 24px; border-radius:3px; color:#fff; background:var(--coral); box-shadow:0 7px 0 #c96c4a; font-size:16px; font-weight:800; letter-spacing:.08em; line-height:1.5; text-decoration:none; transition:transform .2s, box-shadow .2s; }
+    .cta:hover { transform:translateY(3px); box-shadow:0 4px 0 #c96c4a; }
+    .bonus { padding-top:70px; }
+    .bonus-inner { max-width:765px; margin:auto; padding:35px clamp(24px,6vw,70px); border-left:5px solid var(--coral); background:#f4f2f0; }
+    .bonus h2 { font-size:clamp(23px,3vw,32px); }
+    .bonus p:last-child { margin-bottom:0; }
+    .faq { background:var(--mist); }
+    .faq-list { max-width:800px; margin:auto; }
+    .qa { padding:26px 0; border-top:1px solid #d6d0cd; }
+    .qa:last-child { border-bottom:1px solid #d6d0cd; }
+    .qa p { margin-bottom:12px; }
+    .qa p:last-child { margin-bottom:0; }
+    .qa b { color:var(--coral); margin-right:.35em; }
+    .closing { overflow:hidden; position:relative; padding:112px 0; background:var(--coral); color:#fff; text-align:center; }
+    .closing::before, .closing::after { content:""; position:absolute; border-radius:50%; border:32px solid rgba(255,255,255,.17); }
+    .closing::before { width:260px; height:260px; left:-150px; top:-100px; }
+    .closing::after { width:300px; height:300px; right:-190px; bottom:-180px; }
+    .closing .wrap { position:relative; z-index:1; }
+    .closing h2 { margin-bottom:17px; }
+    .closing p { margin-bottom:28px; font-weight:700; }
+    .closing .cta { max-width:520px; margin:auto; background:#fff; color:var(--coral); box-shadow:0 7px 0 rgba(90,55,44,.23); }
+    footer { padding:28px 24px; background:var(--ink); color:#fff; text-align:center; font-size:12px; letter-spacing:.07em; }
+    footer a { margin-right:18px; text-underline-offset:3px; }
+    @media (max-width: 720px) {
+      body { font-size:14px; }
+      .wrap { width:min(100% - 32px, 540px); }
+      .hero { min-height:0; }
+      .nav { height:62px; }
+      .nav a:last-child { padding:5px 11px; font-size:10px; }
+      .hero-grid { grid-template-columns:1fr; display:flex; flex-direction:column; min-height:0; padding-bottom:42px; }
+      .hero-copy { order:1; width:100%; padding:32px 0 0; }
+      .hero-art { order:2; width:calc(100% + 48px); margin:14px -24px -8px; }
+      .hero-catch { margin-top:15px; font-size:25px; line-height:1.55; }
+      h1 { font-size:42px; }
+      .profile { margin-top:18px; }
+      .section { padding:72px 0; }
+      h2 { font-size:28px; }
+      .problem-copy, .solution-text, .report-copy p { font-size:14px; text-align:left; }
+      .intro h2, .problem .intro, .solution .intro { text-align:center; }
+      .worry-grid, .report-grid { grid-template-columns:1fr; }
+      .worry-grid { gap:14px; }
+      .worry { display:grid; grid-template-columns:124px 1fr; align-items:center; }
+      .worry img { height:124px; }
+      .worry p { min-height:0; padding:12px 15px; font-size:14px; }
+      .pillars { margin-top:32px; }
+      .pillar { padding:17px 7px; }
+      .pillar b { font-size:18px; }
+      .report-grid { gap:34px; }
+      .report-image { order:-1; padding:9px; }
+      .flow-grid { grid-template-columns:repeat(2, 1fr); gap:14px; }
+      .flow-card:not(:last-child)::after { display:none; }
+      .flow-card p { min-height:45px; font-size:12px; }
+      .price-box { padding:43px 20px; }
+      .cta { min-height:60px; padding:12px 14px; font-size:14px; }
+      .bonus { padding-top:42px; }
+      .closing { padding:76px 0; }
+    }
+  </style>
+</head>
+<body>
+  <main>
+    <section class="hero">
+      <div class="wrap nav"><a class="brand" href="#top" aria-label="ページ上部へ"></a><a href="#apply">申し込む</a></div>
+      <div class="wrap hero-grid" id="top">
+        <div class="hero-copy">
